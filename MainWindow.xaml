<Window x:Class="Microsoft.Samples.Kinect.BodyBasics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Body Basics" 
        Height="600" Width="700" 
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing" Activated="Window_Activated">
    <Window.Resources>
        <SolidColorBrush x:Key="MediumGreyBrush" Color="#ff6e6e6e" />
        <SolidColorBrush x:Key="KinectPurpleBrush" Color="#ff52318f" />
        <SolidColorBrush x:Key="KinectBlueBrush" Color="#ff00BCF2" />
    </Window.Resources>
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="42*" />
            <RowDefinition Height="85*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="Images\Logo.png" HorizontalAlignment="Left" Stretch="Fill" Height="32" Width="81" Margin="0,14,0,9.2" />
        <TextBlock Grid.Row="0" Margin="0,0,-1.4,0.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource MediumGreyBrush}" FontFamily="Segoe UI" FontSize="18">Body Basics</TextBlock>
        <Image Grid.Row="0" Source="Images\Status.png" Stretch="None" HorizontalAlignment="Center" Margin="312,0,311.6,5.2" />

        <Viewbox HorizontalAlignment="Center" Margin="337,55,336.6,0" Grid.RowSpan="3">
            <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
        </Viewbox>

        <StatusBar Grid.Row="3" HorizontalAlignment="Stretch" Name="statusBar" VerticalAlignment="Bottom" Background="White" Foreground="{StaticResource MediumGreyBrush}" Margin="0,0,-0.4,0.4">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>
        <TextBlock x:Name="trial_rules" HorizontalAlignment="Left" Height="384" Margin="58,62.8,0,0" Grid.Row="1" Grid.RowSpan="2" TextWrapping="Wrap" Text="遊戲玩法" VerticalAlignment="Top" Width="576" FontSize="36" Background="#FF73DF51" Visibility="Hidden"/>
        <Button x:Name="trial_back" Content="Back" HorizontalAlignment="Left" Height="68" Margin="450,210.8,0,0" Grid.Row="2" VerticalAlignment="Top" Width="184" FontSize="36" Click="Trial_back_Click" Visibility="Hidden"/>
        <StackPanel x:Name="start_scenes" Margin="160,27,160,10" Orientation="Vertical" Grid.Row="1" Grid.RowSpan="2" Visibility="Hidden">
            <Button x:Name="start_btn" Margin="0,50,0,60" Content="Start" HorizontalAlignment="Center" Height="80" Width="283" FontSize="48" Click="Button_Click" VerticalAlignment="Top"/>
            <Button x:Name="trial_btn" Margin="0,0,0,60" Content="Trial" HorizontalAlignment="Center" Height="80" Width="283" FontSize="48" Click="Trial_btn_Click"/>
            <Button x:Name="quit_btn" Content="Quit" HorizontalAlignment="Center" Height="80" VerticalAlignment="Top" Width="283" FontSize="48" Click="Quit_btn_Click"/>

        </StackPanel>
        <StackPanel HorizontalAlignment="Left" Height="100" Margin="142,10,0,0" Grid.Row="1" VerticalAlignment="Top" Width="100"/>
        <Grid x:Name="Gameplay" HorizontalAlignment="Left" Height="508" Grid.Row="1" VerticalAlignment="Top" Width="673" Margin="0,0,-1,0" Grid.RowSpan="2">
            <Label Content="&#xD;&#xA;" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.438,-0.015" Width="673" Height="25" Background="#FFFF8952"/>
            <Rectangle Fill="#FF8686F5" HorizontalAlignment="Left" Height="403" Margin="0,95,0,0" Stroke="Black" VerticalAlignment="Top" Width="673"/>
            <Label Content="Xs" HorizontalAlignment="Left" Margin="0,52,0,0" VerticalAlignment="Top" Height="35" Width="54" Background="#FF38B81C" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Label Content="Score :             pt" HorizontalAlignment="Left" Margin="498,52,0,0" VerticalAlignment="Top" Height="35" Width="175" Background="#FF38B81C" FontSize="20"/>
            <Grid x:Name="Endgame" HorizontalAlignment="Left" Height="403" Margin="0,105,0,0" VerticalAlignment="Top" Width="673" Visibility="Hidden">
                <Label Content="Perfect : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="37" Width="199" FontSize="20"/>
                <Label Content="Good   : " HorizontalAlignment="Left" Margin="10,68,0,0" VerticalAlignment="Top" Height="37" Width="199" FontSize="20"/>
                <Label Content="Bad      : " HorizontalAlignment="Left" Margin="10,131,0,0" VerticalAlignment="Top" Height="37" Width="199" FontSize="20"/>
                <Label Content="Miss     : " HorizontalAlignment="Left" Margin="10,195,0,0" VerticalAlignment="Top" Height="37" Width="199" FontSize="20"/>
                <Label Content="Overall :" HorizontalAlignment="Left" Margin="282,10,0,0" VerticalAlignment="Top" Height="37" Width="199" FontSize="20"/>
                <Label Content="      A" HorizontalAlignment="Left" Margin="313,68,0,0" VerticalAlignment="Top" Height="100" Width="275" FontSize="72"/>
            </Grid>
            <Button x:Name="TestBack" Content="Back" HorizontalAlignment="Left" Margin="192,63,0,0" VerticalAlignment="Top" Width="75" Click="TestBack_Click"/>
            <Button x:Name="TestEndgame" Content="Endgame" HorizontalAlignment="Left" Margin="357,63,0,0" VerticalAlignment="Top" Width="75" Click="TestEndgame_Click"/>
        </Grid>

    </Grid>
</Window>
