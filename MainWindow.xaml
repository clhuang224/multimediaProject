<Window x:Class="KinectCoordinateMapping.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KinectCoordinateMapping"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1440" ResizeMode="CanMinimize" Loaded="Window_Loaded" WindowStyle="ThreeDBorderWindow">
    <Grid>
        <Image x:Name="camera" HorizontalAlignment="Left" Height="720" Margin="70,0,0,0" VerticalAlignment="Top" Width="1280"/>
        <Canvas x:Name="canvas"  HorizontalAlignment="Left" Height="720" Margin="70,0,0,0" VerticalAlignment="Top" Width="1280" Background="Transparent"/>
        <Canvas x:Name="map"  HorizontalAlignment="Left" Height="720" Margin="70,0,0,0" VerticalAlignment="Top" Width="1280" Background="Transparent"/>
        <Label x:Name="position" HorizontalAlignment="Left" Margin="0,27,0,0" VerticalAlignment="Top" Height="53" Width="174" Content="position" RenderTransformOrigin="0.088,-0.321"/>
        <Label x:Name="hand_left_state" HorizontalAlignment="Left" Margin="0,42,0,0" VerticalAlignment="Top" Height="54" Width="174" Content="state" RenderTransformOrigin="0.088,-0.321"/>
        <Label x:Name="grab" HorizontalAlignment="Left" Margin="0,58,0,0" VerticalAlignment="Top" Height="53" Width="174" Content="grab out" RenderTransformOrigin="0.088,-0.321"/>
        <Button x:Name="btn_start" Content="start" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="10,3,0,0" Click="btn_start_Click"/>
        <Label x:Name="label1" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,75,0,0" RenderTransformOrigin="0.55,-2.04"/>

    </Grid>
</Window>
